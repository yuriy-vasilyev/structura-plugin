    },
    "./format": {
      "types": "./src/lib/format.ts",
      "import": "./src/lib/format.ts"
    },
    "./score": {
      "types": "./src/lib/score.ts",
      "import": "./src/lib/score.ts"
    },
    "./keywords": {
      "types": "./src/lib/keywords.ts",
      "import": "./src/lib/keywords.ts"
    },
    "./tasks": {
      "types": "./src/lib/tasks.ts",
      "import": "./src/lib/tasks.ts"
    },
    "./links": {
      "types": "./src/lib/links.ts",
      "import": "./src/lib/links.ts"
    },
    "./learn": {
      "types": "./src/lib/learn.ts",
